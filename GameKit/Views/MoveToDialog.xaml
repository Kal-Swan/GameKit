<Window x:Class="GameKit.Views.MoveToDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewModels="clr-namespace:GameKit.ViewModels"
        mc:Ignorable="d"
        Title="Move To..." Height="450" Width="800" 
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=viewModels:MoveToDialogViewModel}">
    <DockPanel Margin="8">
        <TextBox DockPanel.Dock="Top" 
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                 Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Margin="0,0,8,0" Padding="12,4" />
            <Button Content="Move" Click="OnConfirmClick" Padding="12,4" />
        </StackPanel>
        
        <ListBox ItemsSource="{Binding FilteredEntities}" 
                 SelectedItem="{Binding SelectedEntity}"
                 DisplayMemberPath="Name" />
    </DockPanel>
</Window>